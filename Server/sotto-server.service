[Unit]
Description=Sotto dictation server
After=network-online.target
Wants=network-online.target

[Service]
User=sotto
Group=sotto
ExecStart=/opt/sotto/sotto-server
Environment=SOTTO_SERVER_HOST=0.0.0.0
Environment=SOTTO_SERVER_PORT=8391
Environment=SOTTO_SERVER_DATA_DIR=/var/lib/sotto
Environment=SOTTO_SERVER_TOKEN_FILE=/etc/sotto/token
Environment=SOTTO_ENGINE_PATH=/opt/sotto/helpers/sotto-engine
Environment=SOTTO_TEXT_ENGINE_PATH=/opt/sotto/helpers/sotto-text-engine
Environment=SOTTO_VAD_PATH=/opt/sotto/resources/silero-vad.bin
Environment=SOTTO_SPEECH_MODEL=/var/lib/sotto/models/ggml-large-v3-turbo.bin
Environment=SOTTO_TEXT_MODEL=/var/lib/sotto/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
Restart=on-failure

[Install]
WantedBy=multi-user.target

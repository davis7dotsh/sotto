{
  "name": "@v07/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "bun scripts/build.ts",
    "generate": "bun scripts/generate-api.ts",
    "fmt": "prettier --write \"{src,scripts,tests}/**/*.ts\" package.json tsconfig.json ../package.json ../.prettierrc.json",
    "fmt:check": "prettier --check \"{src,scripts,tests}/**/*.ts\" package.json tsconfig.json ../package.json ../.prettierrc.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.4",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "openapi-typescript": "7.10.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
